# gemini (default) or claude. claude shells out to the local `claude` CLI
# and needs it installed + logged into a Claude Code subscription on this
# machine -- it does not use an API key.
LLM_PROVIDER=gemini
# Needed with either provider: the knowledge base searches with Gemini embeddings.
GEMINI_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/qa_copilot
# Used to sign JWT auth tokens -- generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
# Set to false to watch the explorer/executor drive a real (headed) browser window locally
PLAYWRIGHT_HEADLESS=true
# How many test cases to automate at once (each runs its own browser + pytest process)
AUTOMATION_CONCURRENCY=3
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Encrypts the app logins saved on a project's Accounts tab. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to skip accounts. Changing it later makes saved passwords unreadable.
CREDENTIALS_KEY=
